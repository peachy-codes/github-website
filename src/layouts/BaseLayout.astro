---
import { frontmatter as site } from "../pages/_site.md";
import "../../public/assets/style.css";

type NavItem = { label: string; href: string };

type Props = {
  title?: string;
  description?: string;
  brandTitle?: string;
  brandSubtitle?: string;
  footerText?: string;
  currentPath?: string;
};

const { 
  title = site.defaultTitle ?? "peach productions", 
  description = site.defaultDescription ?? "",
  brandTitle = site.brandTitle ?? "peach productions",
  brandSubtitle = site.brandSubtitle ?? "a spatial design studio",
  footerText = site.footerText ?? "intent motivates design",
  currentPath = Astro.url.pathname
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navItems: NavItem[] = Array.isArray(site.nav) ? site.nav : [
  { label: "studio", href: "/" },
  { label: "works", href: "/works" },
  { label: "contact", href: "/contact" },
];

const footerLinks: NavItem[] = Array.isArray(site.footerLinks) ? site.footerLinks : [];

const resolveHref = (href: string) => {
  if (href.startsWith("/")) {
    return `${baseUrl}${href.slice(1)}`;
  }
  return href;
};

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === baseUrl || currentPath === "/";
  }
  return currentPath.includes(href);
};
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Theme Early Detection -->
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme) {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    </script>

    <!-- Single Typography System: Newsreader Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body>
    <div class="site-inner">
      <header class="site-header">
        <div class="brand-block">
          <a href={baseUrl} class="brand-link" aria-label={brandTitle}>
            <span class="brand-title">{brandTitle}</span>
            {brandSubtitle && <span class="brand-subtitle">{brandSubtitle}</span>}
          </a>
        </div>

        <div class="header-right">
          <nav class="nav-links" aria-label="Primary Navigation">
            {navItems.map((item) => (
              <a 
                href={resolveHref(item.href)} 
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="toggle dark or light mode">toggle dark/light</button>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-content">
          <span>{footerText}</span>
          {footerLinks.length > 0 && (
            <div class="footer-links">
              {footerLinks.map((link) => (
                <a 
                  href={resolveHref(link.href)}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </footer>
    </div>

    <!-- Theme Toggle Handler -->
    <script is:inline>
      const btn = document.getElementById('themeToggleBtn');
      if (btn) {
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
