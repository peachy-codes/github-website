---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout 
  title={frontmatter?.title ?? "Georgia von Minden"} 
  description={frontmatter?.description}
>
  <section class="stream-section" style="padding-top: 2.75rem; padding-bottom: 1.5rem;">
    <div class="container">
      {frontmatter?.label && <div class="section-label">{frontmatter.label}</div>}
      <h1 style="margin-bottom: 0.5rem;">{frontmatter?.heading || frontmatter?.title}</h1>
      {frontmatter?.description && (
        <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 0;">
          {frontmatter.description}
        </p>
      )}
    </div>
  </section>

  <section class="stream-section" style="border-bottom: none; padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <div class="container">
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
