---
import BaseLayout from "@layouts/BaseLayout.astro";
import { frontmatter as site } from "../pages/_site.md";

type Props = {
  frontmatter: {
    title: string;
    role?: string;
    timeline?: string;
    location?: string;
    materials?: string;
    dimensions?: string;
    context?: string;
    overview?: string;
    image?: string;
    status?: "active" | "archived";
    links?: { label: string; href: string }[];
  };
};

const { frontmatter } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hasSpatialSpecs = Boolean(frontmatter.location || frontmatter.materials || frontmatter.dimensions || frontmatter.context);
const backToWorksLabel = site.backToWorksLabel ?? "all works";
const workInquiryLabel = site.workInquiryLabel ?? "inquiries and commissions";
const brandTitle = site.brandTitle ?? "peach productions";
---

<BaseLayout title={`${frontmatter.title} • ${brandTitle}`}>
  <section class="page-section">
    <div style="margin-bottom: 28px;">
      <a href={`${baseUrl}works`} style="font-style: italic; color: var(--muted); font-size: 15px;">
        {backToWorksLabel}
      </a>
    </div>

    <h1 style="font-size: 36px; margin-bottom: 8px;">{frontmatter.title}</h1>

    <div class="project-spec-line">
      {([frontmatter.location, frontmatter.timeline].filter(Boolean).length > 0) && (
        <div>{[frontmatter.location, frontmatter.timeline].filter(Boolean).join(" ")}</div>
      )}
      {frontmatter.role && (
        <div style="margin-top: 2px;">{frontmatter.role}</div>
      )}
    </div>

    {frontmatter.overview && (
      <p style="font-size: 18px; line-height: 1.65; color: var(--text); margin-bottom: 28px; max-width: 700px;">
        {frontmatter.overview}
      </p>
    )}

    {hasSpatialSpecs && (
      <div class="project-specs-compact">
        {frontmatter.materials && <span>materials: {frontmatter.materials}</span>}
        {frontmatter.dimensions && <span>scale: {frontmatter.dimensions}</span>}
        {frontmatter.context && <span>exhibition: {frontmatter.context}</span>}
      </div>
    )}

    {frontmatter.links && frontmatter.links.length > 0 && (
      <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 32px; font-style: italic; font-size: 15px;">
        {frontmatter.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}
          </a>
        ))}
      </div>
    )}

    <article class="prose">
      <slot />
    </article>

    <div class="project-detail-nav">
      <a href={`${baseUrl}works`}>
        {backToWorksLabel}
      </a>
      <a href={`${baseUrl}contact`}>
        {workInquiryLabel}
      </a>
    </div>
  </section>
</BaseLayout>
