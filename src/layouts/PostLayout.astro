---
import BaseLayout from "@layouts/BaseLayout.astro";

type Props = {
  frontmatter: {
    title: string;
    date: string;
    summary?: string;
    tags?: string[];
    reading_time?: string | number;
  };
};

const { frontmatter } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${frontmatter.title} • Georgia von Minden`} description={frontmatter.summary}>
  <section class="stream-section" style="padding-top: 2.75rem; padding-bottom: 1.5rem;">
    <div class="container">
      <a href={`${baseUrl}writing`} style="font-size: 0.8rem; font-weight: 600; color: var(--accent); display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 1rem;">
        ← Back to all writing
      </a>

      <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); margin-bottom: 0.5rem;">
        <time datetime={frontmatter.date}>{frontmatter.date}</time>
        {frontmatter.reading_time && <span>• {frontmatter.reading_time} read</span>}
      </div>

      <h1 style="font-size: 1.5rem; line-height: 1.3; margin-bottom: 0.65rem;">
        {frontmatter.title}
      </h1>

      {frontmatter.summary && (
        <p style="font-size: 0.975rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 0.85rem;">
          {frontmatter.summary}
        </p>
      )}

      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="tag-list" style="margin-top: 0.5rem;">
          {frontmatter.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </div>
  </section>

  <section class="stream-section" style="border-bottom: none; padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <div class="container">
      <article class="prose" style="font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.75;">
        <slot />
      </article>

      <div style="margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <a href={`${baseUrl}writing`} style="font-size: 0.825rem; font-weight: 600; color: var(--accent);">
          ← Back to all writing
        </a>
        <a href={`${baseUrl}contact`} class="btn btn-secondary" style="font-size: 0.775rem;">
          Share thoughts →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
