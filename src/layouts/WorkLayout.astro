---
import BaseLayout from "./BaseLayout.astro";
import ProjectGrid from "@components/ProjectGrid.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout 
  title={frontmatter?.title ?? "Work & Research • Georgia von Minden"} 
  description={frontmatter?.description}
>
  <section class="stream-section" style="padding-top: 2.75rem; padding-bottom: 1.5rem;">
    <div class="container">
      {frontmatter?.label && <div class="section-label">{frontmatter.label}</div>}
      <h1 style="margin-bottom: 0.5rem;">{frontmatter?.heading || frontmatter?.title || "Selected Work"}</h1>
      {frontmatter?.description && (
        <p style="color: var(--text-secondary); margin-bottom: 0; font-size: 0.95rem;">
          {frontmatter.description}
        </p>
      )}
    </div>
  </section>

  <section class="stream-section" style="border-bottom: none; padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <div class="container">
      <article class="prose" style="margin-bottom: 1.5rem;">
        <slot />
      </article>
      <ProjectGrid includeArchived={frontmatter?.includeArchived ?? false} />
    </div>
  </section>
</BaseLayout>
