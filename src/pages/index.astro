---
import BaseLayout from "@layouts/BaseLayout.astro";
import LatestPosts from "@components/LatestPosts.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import TestimonialList from "@components/TestimonialList.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <!-- Compact Intro Stream -->
  <section class="stream-section" style="padding-top: 2.75rem;">
    <div class="container">
      <div style="margin-bottom: 0.85rem;">
        <span class="status-badge">
          <span class="status-dot"></span>
          <span>Available for research & ML engineering</span>
        </span>
      </div>

      <h1 style="margin-bottom: 0.85rem;">
        Machine learning for privacy, accountability, and civil rights.
      </h1>

      <div style="color: var(--text-secondary); line-height: 1.65;">
        <p style="margin-bottom: 0.75rem;">
          I’m <strong>Georgia von Minden</strong>, a machine learning engineer and data scientist in San Francisco. I build local-first AI pipelines, multimodal extraction engines, and empirical geospatial analyses for civil rights investigations and legal discovery.
        </p>
        <p style="margin-bottom: 0;">
          When constitutional lawsuits involve hundreds of hours of body camera video, dense PDFs, and email archives, public cloud APIs risk violating protective orders. I design reproducible, local-first systems that process sensitive data with complete sovereignty.
        </p>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem;">
        <a href="#work" class="btn btn-primary">
          Selected Work ↓
        </a>
        <a href={`${baseUrl}photos`} class="btn btn-secondary">
          Photos
        </a>
        <a href={`${baseUrl}writing`} class="btn btn-secondary">
          Writing
        </a>
        <a href={`${baseUrl}about`} class="btn btn-secondary">
          About
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Work Stream -->
  <section id="work" class="stream-section">
    <div class="container">
      <div class="stream-header">
        <div class="section-label">01 / Portfolio</div>
        <h2>Selected Work & Research</h2>
        <p>End-to-end ML pipelines, empirical spatial analytics, and legal discovery tooling.</p>
      </div>

      <ProjectGrid slugs={["sf-flock-alpr-privacy", "aclu-legal-doc-pipeline", "lgbtqai-platform-rag", "discrete-diffusion-transformer", "umap-hull-exploration", "card-research"]} />

      <div style="margin-top: 1.5rem; text-align: center;">
        <a href={`${baseUrl}work`} class="btn btn-secondary" style="font-size: 0.8rem;">
          All projects & research →
        </a>
      </div>
    </div>
  </section>

  <!-- Writing Stream -->
  <section class="stream-section">
    <div class="container">
      <div class="stream-header">
        <div class="section-label">02 / Writing</div>
        <h2>Essays & Field Notes</h2>
        <p>Reflections on discovery scaling, local-first ML architectures, and MLOps.</p>
      </div>

      <LatestPosts limit={3} />

      <div style="margin-top: 1.5rem; text-align: center;">
        <a href={`${baseUrl}writing`} class="btn btn-secondary" style="font-size: 0.8rem;">
          All essays →
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials & Endorsements -->
  <section class="stream-section">
    <div class="container">
      <div class="stream-header">
        <div class="section-label">03 / Collaborations</div>
        <h2>Investigator & Faculty Notes</h2>
      </div>

      <TestimonialList />
    </div>
  </section>

  <!-- Contact CTA Stream Block -->
  <section class="stream-section" style="border-bottom: none; padding-bottom: 3rem;">
    <div class="container">
      <div class="section-label">04 / Connect</div>
      <h2 style="margin-bottom: 0.4rem;">Let’s collaborate.</h2>
      <p style="color: var(--text-secondary); margin-bottom: 1.15rem; font-size: 0.925rem;">
        Whether you’re dealing with high-volume legal discovery, investigating algorithmic bias, or building on-premise ML workflows, I’d love to connect.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
        <a href="mailto:georgia.vonminden@gmail.com" class="btn btn-primary">
          georgia.vonminden@gmail.com
        </a>
        <a href={`${baseUrl}contact`} class="btn btn-secondary">
          Contact & Socials →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
