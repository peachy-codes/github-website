---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const items = await getCollection("research", ({ data }) => !data.draft);
---

<BaseLayout title="Research • Georgia von Minden" description="Research publications and technical notes.">
  <div style="background-color: var(--surface); border-bottom: 1px solid var(--border); padding: 4rem 0 3rem 0;">
    <div class="container">
      <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
        Empirical & Applied Research
      </div>
      <h1 style="margin-bottom: 1rem;">Research</h1>
      <p style="font-size: 1.15rem; max-width: 720px; color: var(--text-secondary); margin-bottom: 0;">
        Applied research notes in statistical disparate impact, computational graph theory, and algorithmic accountability.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container-narrow">
      <div class="writing-list">
        {items.map(({ slug, data }) => (
          <a href={`${baseUrl}research/${slug}/`} class="writing-item">
            <div class="writing-item-header">
              <div class="writing-item-title">{data.title}</div>
              <div class="writing-item-meta">
                <time datetime={data.date}>{data.date}</time>
              </div>
            </div>
            {data.summary && <p class="writing-item-summary">{data.summary}</p>}
            {data.tags && data.tags.length > 0 && (
              <div class="tag-list" style="margin-top: 0.5rem;">
                {data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
