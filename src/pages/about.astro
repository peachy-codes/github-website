---
import BaseLayout from "@layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="About • Georgia von Minden" description="Background, systems philosophy, and technical toolkit of Georgia von Minden.">
  <section class="stream-section" style="padding-top: 2.75rem; padding-bottom: 1.5rem;">
    <div class="container">
      <div class="section-label">Background & Philosophy</div>
      <h1 style="margin-bottom: 0.5rem;">About Georgia</h1>
      <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 0;">
        I’m a machine learning engineer and data scientist building local-first AI systems and empirical analytics for civil rights investigations.
      </p>
    </div>
  </section>

  <section class="stream-section" style="border-bottom: none; padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <div class="container">
      <article class="prose">
        <h2>What I Do</h2>
        <p>
          My work focuses on building computational infrastructure for contexts where failure modes carry real human costs. This includes engineering local document and audio processing pipelines for public-interest legal teams, analyzing disparate impact in law enforcement practices using geospatial regression, and modeling temporal communications dynamics across large institutions.
        </p>
        <p>
          I hold an M.S. in Data Science from the University of San Francisco, where my research focused on combining spatial analysis (ArcGIS, Census data) with NLP and network graph analytics (NetworkX, LDA) to support constitutional litigation.
        </p>

        <h2>Systems & Engineering Philosophy</h2>
        
        <h3>1. Data Sovereignty & Local-First AI</h3>
        <p>
          In civil rights litigation and safety-critical domains, uploading confidential discovery files or protected community data to third-party commercial APIs is an unacceptable risk. I prioritize designing systems that run hermetically on dedicated local hardware—leveraging open-weights transformers, local Whisper audio transcription, and on-premise vector indices.
        </p>

        <h3>2. Statistical Humility & Interpretability</h3>
        <p>
          A high F1-score in a notebook means nothing if the model cannot be explained under cross-examination or if errors disproportionately impact vulnerable populations. I advocate for interpretable modeling (SHAP feature attribution, confidence thresholds, explicit boundary audits) over opaque black boxes.
        </p>

        <h3>3. End-to-End Engineering Craft</h3>
        <p>
          Reliable ML is 90% systems engineering and data hygiene. I build full-lifecycle pipelines: from raw document ingestion and OCR binarization to deterministic data versioning (DVC), workflow orchestration (Metaflow/Airflow), and containerized deployments.
        </p>

        <h2>Technical Toolkit</h2>

        <div style="margin: 1.5rem 0; display: flex; flex-direction: column; gap: 1rem;">
          <div style="border-bottom: 1px dashed var(--border); padding-bottom: 0.85rem;">
            <div style="font-weight: 600; font-size: 0.875rem; margin-bottom: 0.35rem; color: var(--text-primary);">Data Systems & Pipelines</div>
            <div class="tag-list">
              <span class="tag">Python</span>
              <span class="tag">pandas</span>
              <span class="tag">DuckDB / SQL</span>
              <span class="tag">MongoDB</span>
              <span class="tag">Airflow</span>
              <span class="tag">Metaflow</span>
              <span class="tag">DVC</span>
              <span class="tag">Tesseract OCR</span>
            </div>
          </div>

          <div style="border-bottom: 1px dashed var(--border); padding-bottom: 0.85rem;">
            <div style="font-weight: 600; font-size: 0.875rem; margin-bottom: 0.35rem; color: var(--text-primary);">Modeling, NLP & Graph Analytics</div>
            <div class="tag-list">
              <span class="tag">PyTorch</span>
              <span class="tag">Transformers</span>
              <span class="tag">Whisper</span>
              <span class="tag">scikit-learn</span>
              <span class="tag">NetworkX</span>
              <span class="tag">SHAP</span>
              <span class="tag">UMAP</span>
              <span class="tag">ArcGIS / GeoPandas</span>
            </div>
          </div>

          <div>
            <div style="font-weight: 600; font-size: 0.875rem; margin-bottom: 0.35rem; color: var(--text-primary);">Infrastructure & Governance</div>
            <div class="tag-list">
              <span class="tag">Docker</span>
              <span class="tag">Kubernetes</span>
              <span class="tag">GCP</span>
              <span class="tag">MLflow</span>
              <span class="tag">Linux / OpSec</span>
              <span class="tag">Git & CI/CD</span>
            </div>
          </div>
        </div>

        <h2>Community Mentoring & Visual Computing</h2>
        <p>
          Beyond production machine learning and research:
        </p>
        <ul>
          <li><strong>Community Data Mentoring:</strong> I work with <em>Street Spirit</em> in the East Bay, providing data literacy training and technical guidance for grassroots investigative reporting—including supporting the creation of <a href="https://sweptoffthemap.com" target="_blank" rel="noopener noreferrer">Swept Off The Map</a> to document and visualize municipal encampment sweeps.</li>
          <li><strong>Generative Computing & Computational Physics:</strong> I write custom generative sketches and physics simulations in Processing (Java) and GLSL—exploring N-body gravitational dynamics, relativistic light bending, genetic cellular automata, botanical growth models, and sunset gradient fields.</li>
        </ul>

        <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border); display: flex; gap: 0.75rem; align-items: center;">
          <a href={`${baseUrl}contact`} class="btn btn-primary">
            Get in touch →
          </a>
          <a href={`${baseUrl}work`} class="btn btn-secondary">
            View portfolio
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
